<?xml version="1.0" encoding="utf-8"?>
<!-- أندرويد 12+: نسخ Google السحابي + النقل لجوال جديد. ملفات Hive في مجلد app_flutter -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
